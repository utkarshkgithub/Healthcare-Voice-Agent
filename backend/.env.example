# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# ─── Application ─────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: openai | gemini | cerebras
#
# Cerebras is recommended for this app: the voice pipeline makes up to five
# sequential LLM calls per turn, so inference cost and latency dominate.
# It serves an OpenAI-compatible API, so switching costs nothing but this value.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b

# ─── Speech Provider ─────────────────────────────────────────────────────────
# Use 'webapi' for local dev (no API key needed).
# Use 'deepgram' for production-quality STT/TTS.
VOICE_PROVIDER=webapi
DEEPGRAM_API_KEY=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO


# ─── Razorpay Payment ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED. Signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails if this is unset — there is no insecure default.
JWT_SECRET=
JWT_TTL_SECONDS=3600

# ─── Clinical ──────────────────────────────────────────────────────────────
# Number spoken to the patient on the emergency path. Localise per deployment.
EMERGENCY_NUMBER=108

# ─── Database pool ─────────────────────────────────────────────────────────
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10
